{
  "name": "lendloop",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @lendloop/frontend --filter @lendloop/backend dev",
    "dev:frontend": "pnpm --filter @lendloop/frontend dev",
    "dev:backend": "pnpm --filter @lendloop/backend dev",
    "build": "pnpm --filter @lendloop/frontend build",
    "format": "pnpm --filter @lendloop/frontend format"
  }
}
